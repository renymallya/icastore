# --- Database (set automatically by the Neon integration on Vercel) ---
DATABASE_URL=

# --- Images (set automatically when you connect a Vercel Blob store) ---
BLOB_READ_WRITE_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="icastore <orders@icastore.co.tz>"
# Where new-order / new-commission alerts go
OWNER_EMAIL=you@example.com

# --- Admin panel ---
ADMIN_PASSWORD=change-me-to-a-long-password
# Any random 32+ character string: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Store / M-Pesa ---
NEXT_PUBLIC_SITE_URL=https://icastore.co.tz
NEXT_PUBLIC_LIPA_NAMBA=
NEXT_PUBLIC_LIPA_NAME=ICASTORE
# International format without +, e.g. 2557XXXXXXXX
NEXT_PUBLIC_WHATSAPP=
